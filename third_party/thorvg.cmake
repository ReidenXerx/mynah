# ThorVG (docs/LINUX-KDE-PLAN.md, "Animated bird"): the Lottie renderer behind
# mynah_bird_*, pinned as a submodule like whisper.cpp and statically linked
# into libmynah on every platform, so both pills draw the same frames.
#
# ThorVG builds with Meson, not CMake. Rather than drive Meson from here, its
# sources are compiled directly, the way Godot vendors it: the file lists
# below mirror src/*/meson.build, and config.h — which Meson would generate —
# is written here with just what mynah uses: the CPU raster engine and the
# Lottie loader. No threads (the bird is ~50 px; rendering is synchronous on
# the UI thread), no expressions (scripted motion, needs a JS engine, not
# used by bird.json), no SIMD variant, no file I/O (the animation is embedded).
# A bump of the submodule re-checks these lists against the meson files.

set(THORVG_DIR "${CMAKE_CURRENT_LIST_DIR}/thorvg")
if(NOT EXISTS "${THORVG_DIR}/inc/thorvg.h")
    message(FATAL_ERROR "third_party/thorvg is empty: git submodule update --init --recursive")
endif()

# Meson's `version:` from the submodule's own meson.build, for THORVG_VERSION_STRING.
file(READ "${THORVG_DIR}/meson.build" thorvg_meson LIMIT 2000)
string(REGEX MATCH "version : '([0-9.]+)'" _ "${thorvg_meson}")
set(THORVG_VERSION "${CMAKE_MATCH_1}")

# file(CONFIGURE) rewrites it only when it changes: every ThorVG source
# includes it, so a plain file(WRITE) would rebuild the library on every
# configure.
set(thorvg_config_dir "${CMAKE_BINARY_DIR}/thorvg-config")
file(CONFIGURE OUTPUT "${thorvg_config_dir}/config.h" CONTENT
"/* Generated by third_party/thorvg.cmake — what Meson would write for the
 * options mynah builds with. */
#define THORVG_VERSION_STRING \"${THORVG_VERSION}\"
#define THORVG_CPU_ENGINE_SUPPORT 1
#define THORVG_LOTTIE_LOADER_SUPPORT 1
" @ONLY)

set(thorvg_src "${THORVG_DIR}/src")

# tvgInitializer.cpp replaces the GLOBAL operator new/delete (and new[] /
# delete[]) with plain malloc/free — for the whole process, not just
# ThorVG: whisper.cpp, Qt and the core would all allocate through it, and
# its new returns nullptr instead of throwing std::bad_alloc. It also leaves
# out the sized delete C++14 code calls, which ASan reports as an
# alloc-dealloc mismatch on whisper.cpp's own maps. So that one file is
# compiled from a copy without those four definitions, and ThorVG uses the
# standard allocator like everything else. Checked, not hoped: if a bump
# changes them, configure stops instead of quietly compiling them back in.
set(thorvg_initializer "${thorvg_src}/renderer/tvgInitializer.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${thorvg_initializer}")
file(READ "${thorvg_initializer}" initializer)
set(operator_definition "void\\*? ?operator (new|delete)(\\[\\])?\\(([^)]*)\\)( noexcept)?\n{\n[^}]*}")
# (Counted by name: a CMake list splits on the `;` inside the bodies.)
string(REGEX MATCHALL "operator (new|delete)" operators "${initializer}")
list(LENGTH operators operator_count)
string(REGEX REPLACE "${operator_definition}" "" initializer "${initializer}")
string(FIND "${initializer}" "operator new" new_left)
string(FIND "${initializer}" "operator delete" delete_left)
if(NOT operator_count EQUAL 4 OR NOT new_left EQUAL -1 OR NOT delete_left EQUAL -1)
    message(FATAL_ERROR
        "third_party/thorvg.cmake: tvgInitializer.cpp no longer defines exactly the four global "
        "operator new/delete overrides this build removes (found ${operator_count}). Re-check it "
        "after the ThorVG bump — the process-wide allocator must stay the standard one.")
endif()
set(thorvg_initializer_copy "${CMAKE_BINARY_DIR}/thorvg-src/tvgInitializer.cpp")
set(previous "")
if(EXISTS "${thorvg_initializer_copy}")
    file(READ "${thorvg_initializer_copy}" previous)
endif()
if(NOT previous STREQUAL initializer)
    file(WRITE "${thorvg_initializer_copy}" "${initializer}")
endif()

add_library(thorvg STATIC
    ${thorvg_src}/common/tvgCompressor.cpp
    ${thorvg_src}/common/tvgMath.cpp
    ${thorvg_src}/common/tvgStr.cpp
    ${thorvg_src}/renderer/tvgAccessor.cpp
    ${thorvg_src}/renderer/tvgAnimation.cpp
    ${thorvg_src}/renderer/tvgCanvas.cpp
    ${thorvg_src}/renderer/tvgFill.cpp
    ${thorvg_initializer_copy}
    ${thorvg_src}/renderer/tvgLoaderMgr.cpp
    ${thorvg_src}/renderer/tvgPaint.cpp
    ${thorvg_src}/renderer/tvgPicture.cpp
    ${thorvg_src}/renderer/tvgRender.cpp
    ${thorvg_src}/renderer/tvgSaver.cpp
    ${thorvg_src}/renderer/tvgScene.cpp
    ${thorvg_src}/renderer/tvgShape.cpp
    ${thorvg_src}/renderer/tvgTaskScheduler.cpp
    ${thorvg_src}/renderer/tvgText.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwBlendOp.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwFill.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwImage.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwMemPool.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwPostEffect.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwRaster.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwRasterCore.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwRenderer.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwRle.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwShape.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwStroke.cpp
    ${thorvg_src}/renderer/cpu_engine/tvgSwUtil.cpp
    ${thorvg_src}/loaders/raw/tvgRawLoader.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieAnimation.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieBuilder.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieExpressions.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieInterpolator.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieLoader.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieModel.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieModifier.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieParserHandler.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieParser.cpp
    ${thorvg_src}/loaders/lottie/tvgLottieProperty.cpp
)
target_include_directories(thorvg
    PUBLIC  ${THORVG_DIR}/inc ${thorvg_src}/loaders/lottie
    PRIVATE ${thorvg_config_dir} ${thorvg_src}/common ${thorvg_src}/renderer
            ${thorvg_src}/renderer/cpu_engine ${thorvg_src}/loaders
            ${thorvg_src}/loaders/raw)
target_compile_definitions(thorvg PUBLIC TVG_STATIC)
# Upstream's own standard (meson.build: cpp_std=c++14) and visibility.
set_target_properties(thorvg PROPERTIES
    CXX_STANDARD 14 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF
    CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON
    POSITION_INDEPENDENT_CODE ON)
# Its warnings are not ours to fix.
target_compile_options(thorvg PRIVATE -w)
# Meson's release flags — no exceptions or RTTI inside the library, nothing
# crosses its boundary that needs them — and, like Meson, only without a
# sanitizer: UBSan's vptr check needs RTTI.
if(MYNAH_SANITIZE STREQUAL "")
    target_compile_options(thorvg PRIVATE -fno-exceptions -fno-rtti -fno-math-errno)
endif()
install(TARGETS thorvg ARCHIVE DESTINATION lib)
