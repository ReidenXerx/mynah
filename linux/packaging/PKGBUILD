# Maintainer: Mynah <https://github.com/ReidenXerx/mynah>
# The release package. The AUR gets the -git variant first (see
# PKGBUILD-git); this one builds from a tagged release.
#
# Build the packages locally (an Arch machine or container):
#   cd packaging && makepkg -si

pkgbase=mynah
pkgname=('mynah' 'mynah-kde')
pkgver=0.14.0
pkgrel=1
pkgdesc="Say it, and it types where you are — dictation on Wayland, on-device"
arch=('x86_64')
url="https://duduphudu.app/mynah/"
license=('MIT')
makedepends=(
    'cmake' 'git' 'pkgconf'
    'vulkan-headers'     # the ggml Vulkan backend (-DGGML_VULKAN=ON) …
    'spirv-headers'      # … which also needs the SPIR-V headers, and …
    'shaderc'            # … compiles its shaders with glslc at build time
    'wayland-protocols'          # ext-data-control-v1.xml, for the KWin typer
    'plasma-wayland-protocols'   # fake-input.xml, likewise
    'extra-cmake-modules'        # mynah-kde (Stage 8), and the Qt/KDE it links:
    'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland'
    'kirigami' 'kdeclarative' 'qqc2-desktop-style'
    'kcoreaddons' 'kglobalaccel' 'kstatusnotifieritem' 'kwindowsystem' 'kdbusaddons' 'ki18n'
    'layer-shell-qt'
)

source=("git+https://github.com/ReidenXerx/mynah.git#tag=v${pkgver}"
        "git+https://github.com/ggml-org/whisper.cpp.git")
sha256sums=('SKIP' 'SKIP')  # git sources: pinned by tag and by the submodule commit

# third_party/whisper.cpp is a git submodule, and makepkg does not fetch
# submodules: without this the configure step finds an empty directory.
# The submodule is pointed at the clone makepkg already made (the second
# source), and checked out at exactly the commit the repository pins (M6).
prepare() {
    cd "$srcdir/mynah"
    git submodule init
    git config submodule.third_party/whisper.cpp.url "$srcdir/whisper.cpp"
    git -c protocol.file.allow=always submodule update
}

build() {
    cmake -S "$srcdir/mynah" -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DMYNAH_CPU=x86-64-v3 \
        -DMYNAH_VULKAN=ON \
        -DMYNAH_BUILD_TESTS=OFF
    cmake --build build -j"$(nproc)"
}

package_mynah() {
    depends=(
        'pipewire'           # audio capture, straight through libpipewire
        'wayland'            # typing on KWin: fake-input + ext-data-control, in-process
        'curl'               # model downloads
        'openssl'            # download hash verification
        'vulkan-icd-loader'  # the ggml Vulkan backend (the gpu tier)
        'gcc-libs'
    )
    optdepends=(
        'wtype: typing on Hyprland and other wlroots compositors'
        'wl-clipboard: pasting on Hyprland into apps that ignore the virtual keyboard'
    )
    provides=('mynah')
    conflicts=('mynah-git')

    # The binary, static-linked against the pinned whisper.cpp.
    install -Dm755 build/linux/mynah "$pkgdir/usr/bin/mynah"

    # The login service, driven by `mynah service install`.
    install -Dm644 "$srcdir/mynah/linux/packaging/mynah.service" \
        "$pkgdir/usr/lib/systemd/user/mynah.service"

    # KWin's permission for the paste chord: it grants fake-input only to
    # the binary a .desktop file names (see the file).
    install -Dm644 "$srcdir/mynah/linux/packaging/mynah.desktop" \
        "$pkgdir/usr/share/applications/mynah.desktop"

    # The benchmark clip for the Linux model tiers: a bundled real-speech
    # WAV. Shipped in the source tree; the placeholder below is replaced
    # by the release script when the corpus is recorded.
    install -Dm644 "$srcdir/mynah/linux/packaging/benchmark.wav" \
        "$pkgdir/usr/share/mynah/benchmark.wav"

    install -Dm644 "$srcdir/mynah/LICENSE" "$pkgdir/usr/share/licenses/mynah/LICENSE"
}

# The Plasma front end (docs/LINUX-KDE-PLAN.md, Stage 8): a tray, the global
# shortcut, the floating pill and a settings window over the same engine.
package_mynah-kde() {
    pkgdesc="Dictation for KDE Plasma: tray, shortcut, floating indicator and settings for mynah"
    depends=(
        'mynah'
        'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland'
        'kirigami' 'kdeclarative' 'qqc2-desktop-style'
        'kcoreaddons' 'kglobalaccel' 'kstatusnotifieritem' 'kwindowsystem' 'kdbusaddons' 'ki18n'
        'layer-shell-qt'
    )
    provides=('mynah-kde')
    conflicts=('mynah-kde-git')

    install -Dm755 build/linux/kde/mynah-kde "$pkgdir/usr/bin/mynah-kde"
    # The launcher, and KWin's permission for the paste chord (see the file).
    install -Dm644 "$srcdir/mynah/linux/packaging/mynah-kde.desktop" \
        "$pkgdir/usr/share/applications/mynah-kde.desktop"
    install -Dm644 "$srcdir/mynah/LICENSE" "$pkgdir/usr/share/licenses/mynah-kde/LICENSE"
}
