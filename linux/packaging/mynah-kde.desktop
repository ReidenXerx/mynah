# The Plasma app's launcher. KWin's permission to press the paste chord is
# NOT here but in mynah-kde-typing.desktop: an override of this entry (a
# launcher wrapping the Exec, as GPU-switching tools write) would otherwise
# shadow it and take typing away — KWin grants only to an entry whose Exec
# starts with the binary's own path. No GPU wrapping is needed either:
# mynah lifts a session's NVIDIA hiding itself (gpu = on, gpu_env.hpp).
[Desktop Entry]
Type=Application
Name=mynah
GenericName=Dictation
Comment=Say it, and it types where you are
Exec=/usr/bin/mynah-kde
Icon=audio-input-microphone
Terminal=false
Categories=Utility;Accessibility;
Keywords=dictation;speech;voice;whisper;
StartupNotify=false
