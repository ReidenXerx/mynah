[submodule "third_party/whisper.cpp"]
	path = third_party/whisper.cpp
	url = https://github.com/ggml-org/whisper.cpp
	# Pinned to v1.9.2 — the version the STT integration was written and
	# tested against. Bump deliberately, then re-run the Russian test set:
	# a newer whisper.cpp has changed segmentation behaviour before.
[submodule "third_party/thorvg"]
	path = third_party/thorvg
	url = https://github.com/thorvg/thorvg.git
	# Pinned to v1.1.3 — the Lottie renderer behind mynah_bird_* (the pill's
	# bird), compiled by third_party/thorvg.cmake from a list of its
	# sources. A bump re-checks that list against its meson.build files.
