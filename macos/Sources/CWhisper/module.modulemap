// whisper.cpp's C API, exposed to Swift.
//
// Headers come from the vendored build (`vendor/install/include`), produced by
// `scripts/build-whisper.sh` from the pinned submodule — not from Homebrew.
// Linking Homebrew's copy made the app unshippable: absolute /opt/homebrew
// paths, binaries built for a much newer macOS than our deployment target, and
// compute backends living as loose .so files in Cellar/*/libexec.
//
// `link` is deliberately absent: the static archives are passed explicitly by
// build-app.sh, in dependency order, which a module map cannot express.
module CWhisper [system] {
    header "shim.h"
    export *
}
